# ==============================================================================
# ReportPilot - Environment Configuration Template
# Copy this file to .env.local for local development.
# In production (Vercel, etc.), set these in your environment variables dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Required)
# ------------------------------------------------------------------------------
# Project URL (publicly accessible by Next.js app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (SERVER-ONLY - bypasses RLS, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Authentication (Required)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT authentication tokens (SERVER-ONLY)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-random-32-character-secret-key-here

# ------------------------------------------------------------------------------
# 3. Rate Limiting Configuration (Optional - safe production defaults apply)
# ------------------------------------------------------------------------------
# Login endpoint rate limits
# RATE_LIMIT_LOGIN_IP_MAX=10
# RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=900
# RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
# RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900

# Registration endpoint rate limits
# RATE_LIMIT_SIGNUP_IP_MAX=5
# RATE_LIMIT_SIGNUP_IP_WINDOW_SECONDS=3600

# Team creation / password action rate limits
# RATE_LIMIT_PASSWORD_ACTION_MAX=20
# RATE_LIMIT_PASSWORD_ACTION_WINDOW_SECONDS=3600

# Public Client Portal rate limits
# RATE_LIMIT_PUBLIC_PORTAL_IP_MAX=60
# RATE_LIMIT_PUBLIC_PORTAL_IP_WINDOW_SECONDS=60
# RATE_LIMIT_PUBLIC_PORTAL_TOKEN_MAX=120
# RATE_LIMIT_PUBLIC_PORTAL_TOKEN_WINDOW_SECONDS=60

# Authenticated user actions rate limit
# RATE_LIMIT_AUTH_USER_MAX=200
# RATE_LIMIT_AUTH_USER_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 4. Application Base URL (Optional - defaults to request origin / Vercel domain)
# ------------------------------------------------------------------------------
# In local development: defaults automatically to http://localhost:3000
# On Vercel: defaults automatically to your VERCEL_PROJECT_PRODUCTION_URL
# Set this if you use a custom production domain (e.g. https://app.youragency.com)
# NEXT_PUBLIC_APP_URL=https://your-custom-domain.com
